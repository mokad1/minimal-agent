# 复制本文件为 .env，填入你的令牌即可（.env 已被 .gitignore 忽略，不会提交）
# 这里默认走诺联网关（OpenAI 兼容），也可改成任意 OpenAI 兼容的 base_url。
AGENT_LLM_BASE_URL=https://nodlink.cn/v1
AGENT_LLM_API_KEY=sk-你的令牌
AGENT_LLM_MODEL=gpt-5.5

# 可选调参
AGENT_TEMPERATURE=0.7
AGENT_MAX_TURNS=20
AGENT_MAX_TOKENS=8000
AGENT_KEEP_TURNS=4
AGENT_MAX_ITERATIONS=8
